% ts-facts self-checks — run this file directly:
%
%     datalog lib/checks.dl
%
% Every rule derives `violation(Check, Subject)` for a fact that contradicts
% another; Subject is always a string (integer ids are cast). Exit 1 (no rows) is a clean fact base; exit 0 prints each violation.
% A check over a layer that was not extracted derives nothing, and the engine's
% undefined-predicate warning says so.
%
% This is "Datalog proposes, source verifies" pointed at the extractor: before
% believing an analysis, believe the facts it rests on.

import "../schema/all.dl".

known(I) :- symbol(id: I).
known_file(F) :- file(path: F).

% ── every symbol-valued column names a symbol ────────────────────────────
violation("symbol.parent", P) :- symbol(parent: P), P is not absent, not known(P).
violation("param.fn", F) :- param(fn: F), not known(F).
violation("param.symbol", S) :- param(symbol: S), not known(S).
violation("import_name.target", T) :- import_name(target: T), T is not absent, not known(T).
violation("exports.symbol", S) :- exports(symbol: S), S is not absent, not known(S).
violation("doc.symbol", S) :- doc(symbol: S), not known(S).
violation("jsdoc_tag.symbol", S) :- jsdoc_tag(symbol: S), not known(S).
violation("decorator.target", S) :- decorator(target: S), not known(S).
violation("decorator.decorator", S) :- decorator(decorator: S), S is not absent, not known(S).

% ── every file-valued column names a file ────────────────────────────────
violation("imports.file", F) :- imports(file: F), not known_file(F).
violation("imports.target_file", T) :- imports(target_file: T), T is not absent, not known_file(T).
violation("symbol.file", F) :- symbol(file: F), F is not absent, not known_file(F).
violation("project_file.file", F) :- project_file(file: F), not known_file(F).
violation("file_ancestor.dir", D) :- file_ancestor(dir: D), not dir(path: D).

% ── ids are keys ─────────────────────────────────────────────────────────
violation("symbol.id is not a key", I) :- symbol(id: I, kind: K1), symbol(id: I, kind: K2), K1 != K2.
violation("symbol.id is not a key", I) :- symbol(id: I, line: L1), symbol(id: I, line: L2), L1 != L2.
violation("project symbol without a file", I) :- symbol(id: I, origin: project, file: F), F is absent.
violation("resolved import without a target", F) :- imports(file: F, resolved: true, target_file: T, target_package: P), T is absent, P is absent.

% ── refs ─────────────────────────────────────────────────────────────────
violation("ref.from", F) :- ref(from: F), not known(F).
violation("ref.to", T) :- ref(to: T), not known(T).
violation("call_site.caller", C) :- call_site(caller: C), not known(C).
violation("call_site.callee", C) :- call_site(callee: C), C is not absent, not known(C).
violation("resolved call without a callee", S) :- call_site(id: I, dispatch: D, callee: C), D != unresolved, C is absent, S = I as string.
violation("call_site.id is not a key", S) :- call_site(id: I, line: L1), call_site(id: I, line: L2), L1 != L2, S = I as string.
violation("extends.child", C) :- extends(child: C), not known(C).
violation("extends.parent", P) :- extends(parent: P), not known(P).
violation("implements.class", C) :- implements(class: C), not known(C).
violation("implements.interface", I) :- implements(interface: I), not known(I).
violation("overrides.member", M) :- overrides(member: M), not known(M).
violation("overrides.base", B) :- overrides(base: B), not known(B).
violation("member_access.member", M) :- member_access(member: M), not known(M).
violation("member_access.class", C) :- member_access(class: C), not known(C).
violation("type_ref.to", T) :- type_ref(to: T), not known(T).
violation("symbol_type.symbol", S) :- symbol_type(symbol: S), not known(S).
violation("a ref to a local escaped into ref", T) :- ref(to: T), symbol(id: T, kind: local).
violation("a ref to a local escaped into ref", T) :- ref(to: T), symbol(id: T, kind: parameter).

% ── flow ─────────────────────────────────────────────────────────────────
extracted(L) :- relation_rows(layer: L).
violation("fn.id", F) :- fn(id: F), not known(F).
violation("flow_node.fn", F) :- flow_node(fn: F), not fn(id: F).
violation("flow_edge.from", S) :- flow_edge(from: A), not flow_node(id: A), S = A as string.
violation("flow_edge.to", S) :- flow_edge(to: B), not flow_node(id: B), S = B as string.
violation("edge between two functions", S) :-
  flow_edge(from: A, to: B), flow_node(id: A, fn: F), flow_node(id: B, fn: G), F != G, S = A as string.
violation("fn without exactly one entry", F) :- fn(id: F), N = count { E | flow_node(id: E, fn: F, kind: entry) }, N != 1.
violation("an exit with a successor", S) :- flow_edge(from: A), flow_node(id: A, kind: exit), S = A as string.
violation("def.var", V) :- def(var: V), not known(V).
violation("use.var", V) :- use(var: V), not known(V).
violation("captures.var", V) :- captures(var: V), not known(V).
violation("closure.fn", F) :- closure(fn: F), not fn(id: F).
violation("call_at.call_site", S) :- extracted(refs), call_at(call_site: C), not call_site(id: C), S = C as string.

?- violation(Check, Subject).
