% Spec §16.5 — external fact source. The CSV (header: parent,child) binds to
% the relation `parent`, whose tuples are base facts used exactly like
% in-program facts.
import "data/parents.csv" as parent.

ancestor(X, Y) :- parent(X, Y).
ancestor(X, Y) :- parent(X, Z), ancestor(Z, Y).

?- ancestor("alice", Who).
