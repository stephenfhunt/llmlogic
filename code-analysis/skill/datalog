#!/usr/bin/env bash
# In-repo invocation wrapper for the engine, as the code-analysis skill calls it.
#
# The skill always calls `./datalog`. In this source checkout that is this
# wrapper, which builds the engine from ../../datalog on first use and execs it;
# in a packaged bundle (`package.sh`) the same name is the compiled binary — so
# SKILL.md reads the same in both.
set -euo pipefail

SKILL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
CRATE_DIR="$(cd "$SKILL_DIR/../../datalog" && pwd -P)"
BIN="$CRATE_DIR/target/release/datalog"

if [[ ! -x "$BIN" ]]; then
  echo "datalog: building the engine (first use; compiles DuckDB, ~a few minutes)…" >&2
  cargo build --release --manifest-path "$CRATE_DIR/Cargo.toml" >&2
fi

exec "$BIN" "$@"
