% Type-level structure: which types exist, which symbols live inside which type,
% and which types reference which.
%
%   is_type(T)        a project class, interface, enum or type alias
%   in_type(S, T)     symbol S is T or is (lexically) inside T — its members,
%                     their locals, nested callbacks
%   type_dep(A, B)    something inside type A references something inside type B (A ≠ B)

import "../schema/structure.dl".
import "../schema/refs.dl".

is_type(T) :- symbol(id: T, kind: class, origin: project).
is_type(T) :- symbol(id: T, kind: interface, origin: project).
is_type(T) :- symbol(id: T, kind: enum, origin: project).
is_type(T) :- symbol(id: T, kind: type_alias, origin: project).

in_type(T, T) :- is_type(T).
in_type(S, T) :- symbol(id: S, parent: P), in_type(P, T).

type_dep(A, B) :- ref(from: S, to: X), in_type(S, A), in_type(X, B), A != B.
