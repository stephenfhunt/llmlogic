% Module graph: file-to-file dependencies from imports, their roll-up to
% directories and packages, and the cycles they form.
%
%   file_dep(A, B, Kind)     file A imports file B (Kind: imports.kind)
%   dep(A, B)                any file_dep — type-only imports included
%   runtime_dep(A, B)        loading A loads B: an import the emitted JavaScript
%                            keeps (`imports.runtime`). TypeScript elides one
%                            whose bindings are only used as types even without
%                            `import type`, so `kind` alone over-counts
%   unit(F, Depth, Dir)      file F sits in directory Dir at depth Depth
%                            (a file directly in a shallower directory has no
%                            unit at that depth)
%   unit_dep(Depth, UA, UB)  some file in UA depends on some file in UB
%   package_edge(PA, PB)     a file of package PA depends on one of PB
%   external_dep(F, Pkg)     file F imports from a package outside the root
%   file_reaches(A, B)       a chain of dep leads from A to B
%   in_cycle(F)              F is on an import cycle
%   cycle_edge(A, B)         a dep edge that lies on a cycle
%   namespace_dep(NA, NB)    some file of namespace NA depends on one of NB
%                            (`file.namespace`: a Go package, a Python module)
%   namespace_reaches(A, B), in_namespace_cycle(N), namespace_cycle_edge(A, B)
%                            the same closure and cycles, between namespaces
%
% **The cycle relations follow `dep`, which is every import, type-only
% included.** A cycle they report may not exist at run time; re-derive over
% `runtime_dep` before calling one real (`reference/typescript.md`
% §5, trap 1).
%
% **Where a language imports a namespace rather than a file, ask about cycles
% between namespaces.** A Go package's files use one another with no import
% (`imports.kind: implicit`), so `in_cycle` finds cycles inside a package that
% the language allows and the design does not notice.

import "../schema/structure.dl".

file_dep(A, B, K) :- imports(file: A, target_file: B, kind: K), B is not absent, A != B.
dep(A, B) :- file_dep(A, B, _).
runtime_dep(A, B) :- imports(file: A, target_file: B, runtime: true), A != B.
% Where the emitter could not say (runtime absent), fall back to what is written.
runtime_dep(A, B) :- imports(file: A, target_file: B, runtime: R, kind: K), R is absent, K != type_only, K != type_query, A != B.

unit(F, D, U) :- file_ancestor(file: F, dir: U, depth: D).
unit_dep(D, UA, UB) :- dep(A, B), unit(A, D, UA), unit(B, D, UB), UA != UB.

package_edge(PA, PB) :- dep(A, B), file(path: A, package: PA), file(path: B, package: PB), PA != PB.
external_dep(F, P) :- imports(file: F, target_package: P), P is not absent.

file_reaches(A, B) :- dep(A, B).
file_reaches(A, C) :- dep(A, B), file_reaches(B, C).
in_cycle(F) :- file_reaches(F, F).
cycle_edge(A, B) :- dep(A, B), file_reaches(B, A).

namespace_dep(NA, NB) :- dep(A, B), file(path: A, namespace: NA), file(path: B, namespace: NB), NA != NB.
namespace_reaches(A, B) :- namespace_dep(A, B).
namespace_reaches(A, C) :- namespace_dep(A, B), namespace_reaches(B, C).
in_namespace_cycle(N) :- namespace_reaches(N, N).
namespace_cycle_edge(A, B) :- namespace_dep(A, B), namespace_reaches(B, A).
