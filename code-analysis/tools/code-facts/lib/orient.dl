% A first look at a fact base — run it directly, before asking anything:
%
%     ./datalog <out>/lib/orient.dl
%
% Which layers it has, the size and shape, the most depended-on and most complex
% places, the runtime import cycles, and the blind spots: how many calls and
% names the extractor could not resolve, which is how much any "nothing calls X"
% answer can be trusted. Every line is a place to start, not a finding — and the
% first line bounds all the others, because a count over a layer that was not
% extracted is 0 for a reason that has nothing to do with the code.

import "../schema/meta.dl".
import "../schema/structure.dl".
import "../schema/refs.dl".
import "../schema/flow.dl".
import "modgraph.dl".

% Which layers this extraction actually has. **Read this line first.** A layer
% switched off (`--layers`, `--no-git`) leaves its relations declared and empty,
% so every count over it is 0 — and a 0 that means "not extracted" looks exactly
% like a 0 that means "none". `functions(0)` on a 2.9M-line codebase was this,
% and the engine's `undefined-predicate` warning names a relation rather than
% the number it made wrong (found dogfooding, 2026-09-12).
layer_extracted(L) :- relation_rows(layer: L, rows: R), R > 0.

% Data, not source. A `.json` a module imports is one of the program's files and
% gets a `file` row, but its lines are not code and must not be counted as any.
source_file(F) :- file(path: F, lang: L), L != json.

production_files(N) :- N = count { P | file(path: P, is_test: false, is_decl: false), source_file(P) }.
test_files(N) :- N = count { P | file(path: P, is_test: true), source_file(P) }.
code_lines(N) :- N = sum { L | file(path: P, sloc: L, is_test: false, is_decl: false), source_file(P) }.

% **Gated on their layer, so a 0 that means "not extracted" cannot print.** It
% did: `functions(0)` on a 2.9M-line codebase, because `fn` is a flow-layer
% relation and a repository that size has to be extracted without it. Reporting
% nothing is the honest answer to a question these facts cannot answer, and
% `layer_extracted` above says which those are (found dogfooding, 2026-09-12).
functions(N) :- layer_extracted(flow), N = count { F | fn(id: F, kind: K), K != module }.
classes(N) :- N = count { C | symbol(id: C, kind: class, origin: project) }.
exported_symbols(N) :- N = count { S | symbol(id: S, exported: true, origin: project) }.

importers(F, N) :- file(path: F), N = count { A | dep(A, F) }.
most_imported_count(M) :- M = max { N | importers(_, N) }.
most_imported(F, N) :- most_imported_count(N), importers(F, N).

most_complex_count(M) :- layer_extracted(flow), M = max { C | fn(cyclomatic: C) }.
most_complex(F, C) :- most_complex_count(C), fn(id: F, cyclomatic: C).

largest_count(M) :- M = max { L | file(path: P, sloc: L, is_test: false), source_file(P) }.
largest_file(F, L) :- largest_count(L), file(path: F, sloc: L, is_test: false), source_file(F).

runtime_reaches(A, B) :- runtime_dep(A, B).
runtime_reaches(A, C) :- runtime_dep(A, B), runtime_reaches(B, C).
in_runtime_cycle(F) :- runtime_reaches(F, F).
files_in_runtime_cycles(N) :- N = count { F | in_runtime_cycle(F) }.

% Group keys are projected first: an aggregate is evaluated per binding of the
% atom beside it, so `call_site(dispatch: K), N = count { … }` counts once per
% call site rather than once per dispatch kind.
dispatch_kind(K) :- call_site(dispatch: K).
calls(K, N) :- dispatch_kind(K), N = count { I | call_site(id: I, dispatch: K) }.
unresolved_name_count(N) :- layer_extracted(refs), N = count { X | unresolved_ref(name: X) }.

?- layer_extracted(Layer).
?- production_files(N).
?- test_files(N).
?- code_lines(N).
?- functions(N).
?- classes(N).
?- exported_symbols(N).
?- most_imported(F, N).
?- most_complex(F, C).
?- largest_file(F, L).
?- files_in_runtime_cycles(N).
?- calls(Dispatch, N).
?- unresolved_name_count(N).
