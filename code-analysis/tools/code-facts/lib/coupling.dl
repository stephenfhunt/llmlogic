% Coupling, from symbol-level references rolled up to components (lib/units.dl
% explains the (G, C) component ids — G = -1 files, -2 packages, N ≥ 0
% directories at depth N).
%
%   file_ref(FA, FB, Kind)          a symbol in FA references one in FB
%   comp_edge(G, A, B)              some file of A references some file of B
%   crossing(G, A, B, From, To, Kind, Line)   each reference crossing A → B
%   comp_edge_weight(G, A, B, N)    how many references cross from A to B
%   efferent(G, C, N)               Ce: how many components C depends on
%   afferent(G, C, N)               Ca: how many components depend on C
%   instability(G, C, I)            Ce / (Ca + Ce), a float in [0, 1]; only for
%                                   components with at least one edge
%   abstractness(G, C, A)           (interfaces + abstract classes) / (classes +
%                                   interfaces); only for components with a type
%   distance(G, C, D)               |A + I − 1| — distance from the main sequence
%   sdp_violation(G, A, B)          A depends on B, and B is *less* stable than A
%                                   (the Stable Dependencies Principle, broken)
%   cbo(T, N)                       coupling between objects: how many other
%                                   types T references or is referenced by
%
% Every `ref` kind counts. To measure only runtime coupling, or only type
% coupling, restrict `file_ref` by Kind in a rule of your own.

import "units.dl".
import "types.dl".

file_ref(FA, FB, K) :- ref(from: S, to: T, kind: K), symbol(id: S, file: FA), symbol(id: T, file: FB), FA != FB.

comp_edge(G, A, B) :- file_ref(FA, FB, _), member(G, A, FA), member(G, B, FB), A != B.

crossing(G, A, B, S, T, K, L) :-
  ref(from: S, to: T, kind: K, line: L), symbol(id: S, file: FA), symbol(id: T, file: FB),
  member(G, A, FA), member(G, B, FB), A != B.
comp_edge_weight(G, A, B, N) :- comp_edge(G, A, B), N = count { S | crossing(G, A, B, S, T, K, L) }.

efferent(G, C, N) :- comp(G, C), N = count { B | comp_edge(G, C, B) }.
afferent(G, C, N) :- comp(G, C), N = count { A | comp_edge(G, A, C) }.
instability(G, C, I) :- efferent(G, C, E), afferent(G, C, A), T = A + E, T > 0, I = E as float / T as float.

concrete_or_abstract(G, C, T) :- symbol(id: T, kind: class, origin: project, file: F), member(G, C, F).
concrete_or_abstract(G, C, T) :- symbol(id: T, kind: interface, origin: project, file: F), member(G, C, F).
abstract_type(G, C, T) :- symbol(id: T, kind: interface, origin: project, file: F), member(G, C, F).
abstract_type(G, C, T) :- symbol(id: T, kind: class, is_abstract: true, origin: project, file: F), member(G, C, F).
abstractness(G, C, A) :-
  comp(G, C), N = count { T | concrete_or_abstract(G, C, T) }, N > 0,
  M = count { T | abstract_type(G, C, T) }, A = M as float / N as float.

main_sequence_offset(G, C, X) :- abstractness(G, C, A), instability(G, C, I), X = A + I - 1.0.
distance(G, C, X) :- main_sequence_offset(G, C, X), X >= 0.0.
distance(G, C, D) :- main_sequence_offset(G, C, X), X < 0.0, D = 0.0 - X.

sdp_violation(G, A, B) :- comp_edge(G, A, B), instability(G, A, IA), instability(G, B, IB), IB > IA.

coupled_type(A, B) :- type_dep(A, B).
coupled_type(A, B) :- type_dep(B, A).
cbo(T, N) :- is_type(T), N = count { B | coupled_type(T, B) }.
