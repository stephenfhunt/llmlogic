% Two declared columns of different numeric types added together. Only the
% rule is wrong: both declarations agree with the data, so exactly one
% diagnostic is correct here and it is the rule-level one.
declare item(name: string, qty: int, weight: float).
item("bolt", 4, 1.5).
total(N) :- item(qty: Q, weight: W), N = Q + W.
?- total(N).
