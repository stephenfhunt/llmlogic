# Claude Code: ignore per-checkout *state*, ship shared *config*.
# `.claude/skills/` stays ignored on purpose — a project's skill is a deliverable
# you activate deliberately, not something every clone should load (AGENTS.md).
.claude/*
!.claude/rules/
!.claude/settings.json

# Editor swap/backup files
*.swp
*.swo
*~

# Python projects (experiments/)
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.pytest-tmp/
.ruff_cache/

# A run's verdicts and rendered report are the record and are committed; the full
# per-cell agent transcripts behind them are large and are not (cf. the repo rule
# against committing session transcripts). See experiments/decisions.md.
experiments/results/*/transcripts/

# Dry runs are the stub subject talking to itself. They exercise the pipeline;
# they are not evidence, and results/ is for runs that measured something.
experiments/results/dry-*/
experiments/.workspaces/
.hypothesis/
